{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CaseFile",
  "definitions": {
    "CaseFile": {
      "type": "object",
      "properties": {
        "about": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "suite": {
          "type": "string",
          "enum": [
            "short",
            "master"
          ]
        },
        "design": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "fixture": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Chapter"
          }
        },
        "gitignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Agent"
          }
        },
        "models": {
          "type": "object",
          "properties": {
            "claude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "codex": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "runs": {
          "type": "number"
        },
        "pointer": {
          "type": "boolean"
        },
        "routing_only": {
          "type": "boolean"
        },
        "version_control": {
          "type": "boolean"
        },
        "uses_skill_example": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "normal",
            "boundary",
            "edge"
          ]
        },
        "rejects": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "skillbook-design",
              "skillbook-write"
            ]
          }
        },
        "checks": {
          "$ref": "#/definitions/Checks"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Turn"
          }
        },
        "user": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "facts": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string",
              "enum": [
                "fixed",
                "simulated"
              ]
            }
          },
          "required": [
            "description",
            "facts",
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "fixture",
        "turns"
      ],
      "additionalProperties": false
    },
    "Chapter": {
      "type": "object",
      "properties": {
        "number": {
          "type": "number"
        },
        "start_turn": {
          "type": "number"
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "fixture": {
              "type": "string"
            },
            "overlays": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "untracked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "fixture"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "number",
        "start_turn",
        "checkpoint"
      ],
      "additionalProperties": false
    },
    "Agent": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "Checks": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reads_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_changes": {
          "type": "boolean"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "only_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_contains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "shorter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "words_under": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "only_replacement": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "unchanged_under": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": "string"
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "folder"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "index_links": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": "string"
                  },
                  "contains": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "folder"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "keeps_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states_before_change": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "answer_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_not_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "names_no_skill": {
          "type": "boolean"
        },
        "written_under": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "folder_lacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "folder_contains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "nothing_left_running": {
          "type": "boolean"
        },
        "tmp_has": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tmp_lacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_started_or_answer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_path_has": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions_lack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_pass": {
          "type": "string"
        },
        "never_committed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "heading_once": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "in": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "heading",
            "in"
          ],
          "additionalProperties": false
        },
        "tag_at_head": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tree_lacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "paths_lack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "only_new_files": {
          "type": "object",
          "properties": {
            "matching": {
              "type": "string"
            },
            "at_most": {
              "type": "number"
            }
          },
          "required": [
            "matching",
            "at_most"
          ],
          "additionalProperties": false
        },
        "compare_to": {
          "type": "string",
          "enum": [
            "checkpoint",
            "turn"
          ]
        }
      },
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "number"
        },
        "skill_needs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkillNeed"
          }
        },
        "also_called": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkillNeed"
          }
        },
        "if_taken": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConditionalNeed"
          }
        },
        "rule_marks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "applies": {
                "type": "boolean"
              },
              "deadline": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "const": "first change"
                  },
                  {
                    "type": "string",
                    "const": "answer"
                  }
                ]
              },
              "near_miss": {
                "type": "boolean"
              },
              "missing_piece": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "applies",
              "deadline"
            ],
            "additionalProperties": false
          }
        },
        "judge_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "fresh_session": {
          "type": "boolean"
        },
        "checks": {
          "$ref": "#/definitions/Checks"
        },
        "tagged_checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TaggedCheck"
          }
        },
        "rubric": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rubric"
          }
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    },
    "SkillNeed": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string"
        },
        "deadline": {
          "$ref": "#/definitions/Deadline"
        }
      },
      "required": [
        "skill",
        "deadline"
      ],
      "additionalProperties": false
    },
    "Deadline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "first change"
        },
        {
          "type": "string",
          "const": "answer"
        }
      ]
    },
    "ConditionalNeed": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string"
        },
        "deadline": {
          "$ref": "#/definitions/Deadline"
        },
        "path": {
          "type": "string"
        },
        "taken_when": {
          "$ref": "#/definitions/Checks"
        }
      },
      "required": [
        "deadline",
        "path",
        "skill"
      ],
      "additionalProperties": false
    },
    "TaggedCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "depends_on": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "number"
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "turn",
            "check"
          ],
          "additionalProperties": false
        },
        "assert": {
          "$ref": "#/definitions/Checks"
        }
      },
      "required": [
        "id",
        "tag",
        "assert"
      ],
      "additionalProperties": false
    },
    "Rubric": {
      "type": "object",
      "properties": {
        "source_check": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        },
        "depends_on": {
          "type": "object",
          "properties": {
            "turn": {
              "type": "number"
            },
            "check": {
              "type": "string"
            }
          },
          "required": [
            "turn",
            "check"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "tag",
        "criterion"
      ],
      "additionalProperties": false
    }
  }
}
