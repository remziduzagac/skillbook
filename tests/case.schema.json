{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CaseFile",
  "definitions": {
    "CaseFile": {
      "type": "object",
      "properties": {
        "about": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "fixture": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Agent"
          }
        },
        "models": {
          "type": "object",
          "properties": {
            "claude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "codex": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "runs": {
          "type": "number"
        },
        "pointer": {
          "type": "boolean"
        },
        "routing_only": {
          "type": "boolean"
        },
        "version_control": {
          "type": "boolean"
        },
        "uses_skill_example": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "normal",
            "boundary",
            "edge"
          ]
        },
        "rejects": {
          "type": "string"
        },
        "review": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "skillbook-design",
              "skillbook-write"
            ]
          }
        },
        "checks": {
          "$ref": "#/definitions/Checks"
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Turn"
          }
        }
      },
      "required": [
        "fixture",
        "turns"
      ],
      "additionalProperties": false
    },
    "Agent": {
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "Checks": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reads_not": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_changes": {
          "type": "boolean"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "only_changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_contains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "shorter": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "states_before_change": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "answer_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_not_contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "names_no_skill": {
          "type": "boolean"
        },
        "written_under": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "folder_lacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "nothing_left_running": {
          "type": "boolean"
        },
        "tmp_has": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tmp_lacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_started_or_answer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer_path_has": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions_lack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "number"
        },
        "prompt": {
          "type": "string"
        },
        "fresh_session": {
          "type": "boolean"
        },
        "checks": {
          "$ref": "#/definitions/Checks"
        },
        "rubric": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rubric"
          }
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    },
    "Rubric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "criterion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tag",
        "criterion"
      ],
      "additionalProperties": false
    }
  }
}
